APP_NAME=Gonertia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://goravel.localhost
APP_HOST=0.0.0.0
APP_PORT=3000
APP_DOMAIN=goravel.localhost
VITE_DOMAIN=vite.goravel.localhost
MAILPIT_DOMAIN=mailpit.goravel.localhost

DB_CONNECTION=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=goravel
DB_USERNAME=goravel
DB_PASSWORD=goravel

# Enable this only if bind-mount file events do not work on your host.
VITE_USE_POLLING=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@goravel.localhost
MAIL_FROM_NAME=Gonertia
